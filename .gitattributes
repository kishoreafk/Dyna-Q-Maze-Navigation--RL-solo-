# Normalize text files to LF in the repository.
* text=auto eol=lf

*.py   text eol=lf
*.ipynb text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
*.csv  text
*.json text eol=lf

# Binary artifacts
*.npz  binary
*.gz   binary
*.png  binary
*.jpg  binary
*.pdf  binary
*.zip  binary
