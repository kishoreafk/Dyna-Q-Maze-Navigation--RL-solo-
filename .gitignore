# ---------------------------------------------------------------------------
# Generated experiment outputs
# ---------------------------------------------------------------------------
# The committed reference artifacts (metrics.csv, episodes.csv, figures,
# tables, checkpoints, verification) stay in git.  Bulky per-step logs and
# resume markers are regenerated by scripts/reproduce.py.
*.jsonl.gz
*.done
artifacts/pilot/logs/
artifacts/logs/
artifacts/data/
artifacts/final/
artifacts/runs/
artifacts/ci_smoke/
artifacts/colab_smoke/
artifacts/colab_pilot/
artifacts/colab_final/
artifacts/*/logs/
artifacts/*/__pycache__/

